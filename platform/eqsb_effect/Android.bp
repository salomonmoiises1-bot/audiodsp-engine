cc_defaults {
    name: "eqsb_dsp_defaults",
    vendor: true,
    cpp_std: "c++17",
    cflags: ["-O3", "-ffast-math", "-Wall", "-Wextra", "-Wno-unused-parameter"],
    header_libs: ["libhardware_headers"],
    export_include_dirs: ["../../app/src/main/cpp"],
}

cc_library_static {
    name: "libeqsb_dsp_core",
    defaults: ["eqsb_dsp_defaults"],
    srcs: [
        "../../app/src/main/cpp/EQsbDspEngine.cpp",
        "../../app/src/main/cpp/dsp/BiquadFilter.cpp",
        "../../app/src/main/cpp/eq/EQ32.cpp",
        "../../app/src/main/cpp/dynamics/MDRC.cpp",
        "../../app/src/main/cpp/dynamics/AutoGain.cpp",
        "../../app/src/main/cpp/dynamics/Limiter.cpp",
        "../../app/src/main/cpp/effects/BassBoost.cpp",
        "../../app/src/main/cpp/effects/ToneControl.cpp",
        "../../app/src/main/cpp/effects/SpatialVirtualizer.cpp",
    ],
}

cc_library_shared {
    name: "libeqsb_effect",
    defaults: ["eqsb_dsp_defaults"],
    srcs: ["EQsbEffect.cpp"],
    static_libs: ["libeqsb_dsp_core"],
    relative_install_path: "soundfx",
}
